{
  "name": "AI Recruitment Report Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "generate-recruitment-report",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-1-webhook",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  (SELECT COUNT(*) FROM jobs) AS total_jobs,\n  (SELECT COUNT(*) FROM candidates) AS total_candidates,\n  (SELECT COUNT(*) FROM candidates WHERE approval_status = 'APPROVED' OR approval_status = 'INTERVIEW_SCHEDULED') AS approved_candidates,\n  (SELECT COUNT(*) FROM candidates WHERE approval_status = 'REJECTED') AS rejected_candidates,\n  (SELECT COALESCE(ROUND(AVG(match_score), 2), 0) FROM candidates) AS avg_score;"
      },
      "id": "node-2-mysql",
      "name": "MySQL - Get Recruitment Data",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
      "position": [420, 300],
      "credentials": {
        "mySql": {
          "id": "1",
          "name": "MySQL account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.total_candidates }}",
              "operation": "largerEqual",
              "value2": 0
            }
          ]
        }
      },
      "id": "node-3-filter",
      "name": "Filter Data",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "name": "total_jobs", "value": "={{ $json.total_jobs }}", "type": "number" },
            { "name": "total_candidates", "value": "={{ $json.total_candidates }}", "type": "number" },
            { "name": "approved_candidates", "value": "={{ $json.approved_candidates }}", "type": "number" },
            { "name": "rejected_candidates", "value": "={{ $json.rejected_candidates }}", "type": "number" },
            { "name": "avg_score", "value": "={{ $json.avg_score }}", "type": "number" },
            { "name": "pass_rate", "value": "={{ $json.total_candidates > 0 ? Math.round(($json.approved_candidates / $json.total_candidates) * 100) : 0 }}%", "type": "string" }
          ]
        }
      },
      "id": "node-4-aggregate",
      "name": "Aggregate Statistics",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [860, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "name": "prompt_payload", "value": "Báo cáo: {{ $json.total_jobs }} việc làm, {{ $json.total_candidates }} ứng viên, đỗ {{ $json.approved_candidates }}, điểm TB {{ $json.avg_score }}.", "type": "string" }
          ]
        }
      },
      "id": "node-5-http",
      "name": "HTTP Request / Prepare Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1080, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "ai_insights",
              "value": "Tỷ lệ ứng viên đạt yêu cầu ở mức tích cực. Chất lượng nguồn hồ sơ kỹ thuật cao, điểm trung bình đạt chuẩn. Khuyến nghị đẩy nhanh vòng phỏng vấn để tránh mất ứng viên tiềm năng.",
              "type": "string"
            }
          ]
        }
      },
      "id": "node-6-ai",
      "name": "AI Agent - Analyze Recruitment",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1300, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "name": "report_title", "value": "Báo Cáo Tuyển Dụng Định Kỳ - Phòng Nhân Sự", "type": "string" },
            { "name": "report_content", "value": "TỔNG QUAN: Tổng số vị trí: {{ $('Aggregate Statistics').item.json.total_jobs }} | Tổng ứng viên: {{ $('Aggregate Statistics').item.json.total_candidates }} | Tỉ lệ đỗ: {{ $('Aggregate Statistics').item.json.pass_rate }} | Điểm TB: {{ $('Aggregate Statistics').item.json.avg_score }}. ĐÁNH GIÁ AI: {{ $json.ai_insights }}", "type": "string" }
          ]
        }
      },
      "id": "node-7-generate",
      "name": "Generate Report",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1520, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.report_title }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "node-8-if",
      "name": "IF - Check Report",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1740, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "name": "approval_status", "value": "APPROVED", "type": "string" },
            { "name": "approved_by", "value": "HR Manager (Nguyen Thi My Hoa)", "type": "string" }
          ]
        }
      },
      "id": "node-9-approval",
      "name": "Human Approval",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1960, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO recruitment_reports (report_title, total_jobs, total_candidates, approved_candidates, rejected_candidates, avg_score, ai_insights, approval_status)\nVALUES (\n  '{{ $('Generate Report').item.json.report_title }}',\n  {{ $('Aggregate Statistics').item.json.total_jobs }},\n  {{ $('Aggregate Statistics').item.json.total_candidates }},\n  {{ $('Aggregate Statistics').item.json.approved_candidates }},\n  {{ $('Aggregate Statistics').item.json.rejected_candidates }},\n  {{ $('Aggregate Statistics').item.json.avg_score }},\n  '{{ $('AI Agent - Analyze Recruitment').item.json.ai_insights }}',\n  '{{ $json.approval_status }}'\n);"
      },
      "id": "node-10-save",
      "name": "Save Report",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
      "position": [2180, 300],
      "credentials": {
        "mySql": {
          "id": "1",
          "name": "MySQL account"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "name": "send_to", "value": "management@company.com", "type": "string" },
            { "name": "email_subject", "value": "[Báo cáo Tuyển dụng] {{ $('Generate Report').item.json.report_title }}", "type": "string" },
            { "name": "delivery_status", "value": "SENT_SUCCESSFULLY", "type": "string" }
          ]
        }
      },
      "id": "node-11-send",
      "name": "Send Report",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2400, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO workflow_logs (workflow_name, execution_status, payload)\nVALUES (\n  'AI Recruitment Report Agent',\n  'SUCCESS',\n  '{\"report_title\": \"{{ $('Generate Report').item.json.report_title }}\", \"status\": \"DELIVERED\"}'\n);"
      },
      "id": "node-12-log",
      "name": "Log Execution",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
      "position": [2620, 300],
      "credentials": {
        "mySql": {
          "id": "1",
          "name": "MySQL account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"message\": \"Tạo báo cáo tuyển dụng và gửi thành công!\",\n  \"report_title\": \"{{ $('Generate Report').item.json.report_title }}\",\n  \"statistics\": {\n    \"total_jobs\": {{ $('Aggregate Statistics').item.json.total_jobs }},\n    \"total_candidates\": {{ $('Aggregate Statistics').item.json.total_candidates }},\n    \"pass_rate\": \"{{ $('Aggregate Statistics').item.json.pass_rate }}\",\n    \"avg_score\": {{ $('Aggregate Statistics').item.json.avg_score }}\n  },\n  \"ai_insights\": \"{{ $('AI Agent - Analyze Recruitment').item.json.ai_insights }}\",\n  \"delivery\": \"{{ $json.delivery_status }}\"\n}",
        "options": {}
      },
      "id": "node-13-respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2840, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": { "main": [[{ "node": "MySQL - Get Recruitment Data", "type": "main", "index": 0 }]] },
    "MySQL - Get Recruitment Data": { "main": [[{ "node": "Filter Data", "type": "main", "index": 0 }]] },
    "Filter Data": { "main": [[{ "node": "Aggregate Statistics", "type": "main", "index": 0 }]] },
    "Aggregate Statistics": { "main": [[{ "node": "HTTP Request / Prepare Payload", "type": "main", "index": 0 }]] },
    "HTTP Request / Prepare Payload": { "main": [[{ "node": "AI Agent - Analyze Recruitment", "type": "main", "index": 0 }]] },
    "AI Agent - Analyze Recruitment": { "main": [[{ "node": "Generate Report", "type": "main", "index": 0 }]] },
    "Generate Report": { "main": [[{ "node": "IF - Check Report", "type": "main", "index": 0 }]] },
    "IF - Check Report": { "main": [[{ "node": "Human Approval", "type": "main", "index": 0 }]] },
    "Human Approval": { "main": [[{ "node": "Save Report", "type": "main", "index": 0 }]] },
    "Save Report": { "main": [[{ "node": "Send Report", "type": "main", "index": 0 }]] },
    "Send Report": { "main": [[{ "node": "Log Execution", "type": "main", "index": 0 }]] },
    "Log Execution": { "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]] }
  },
  "active": true
}
