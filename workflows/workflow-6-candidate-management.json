    {
      "parameters": {
        "jsCode": "const candidate = $('Step 3: Fetch Current Candidate').item.json;\nconst newStatus =$('Step 1: Webhook').item.json.body.new_status || 'Đang xem xét';\nconst prompt = `Ứng viên ${candidate.full_name} ứng tuyển vị trí ${candidate.applied_position} vừa được cập nhật sang trạng thái: \"${newStatus}\". Hãy viết một nhận xét tuyển dụng ngắn gọn dưới 25 từ bằng tiếng Việt cho HR.`;\n\nreturn [{\n  json: {\n    candidate_id: candidate.id,\n    full_name: candidate.full_name,\n    applied_position: candidate.applied_position,\n    new_status: newStatus,\n    ai_prompt: prompt\n  }\n}];"
      },
      "id": "391c744f-3604-4070-a4d5-e5f0c431d9e5",
      "name": "Step 5: Build AI Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1344,
        16
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-lite:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key",
              "value": "AQ.Ab8RN6Lw6M9JouQGiXnzmCpEK-Nf4QwHoWHYlCvHTYj5aqmIkg"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "=={{ \n  JSON.stringify({\n    contents: [\n      {\n        parts: [\n          {\n            text: $json.ai_prompt\n          }\n        ]\n      }\n    ]\n  }) \n}}",
        "options": {}
      },
      "id": "6bcddc85-a0bc-4fe1-b616-9d61cb88b8dc",
      "name": "Step 6: Request Gemini AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1136,
        16
      ],
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const candidate = $('Step 5: Build AI Prompt').item.json;\nlet aiNote = '';\n\ntry {\n  if ($json.candidates && $json.candidates[0].content.parts[0].text) {\n    aiNote = $json.candidates[0].content.parts[0].text.trim();\n  } else {\n    throw new Error('Fallback needed');\n  }\n} catch (err) {\n  if (candidate.new_status === 'Đạt') {\n    aiNote = `Hồ sơ ${candidate.full_name} đạt chuẩn vị trí ${candidate.applied_position}. Đề xuất HR liên hệ gửi offer.`;\n  } else if (candidate.new_status === 'Phỏng vấn') {\n    aiNote = `Ứng viên ${candidate.full_name} phù hợp tiêu chí ban đầu. Đề xuất xếp lịch phỏng vấn.`;\n  } else {\n    aiNote = `Hồ sơ ${candidate.full_name} chưa phù hợp đợt tuyển dụng này. Lưu hồ sơ ứng viên.`;\n  }\n}\n\nreturn [{\n  json: {\n    candidate_id: candidate.candidate_id,\n    new_status: candidate.new_status,\n    ai_evaluation: aiNote\n  }\n}];"
      },
      "id": "1b034803-8a69-4a01-98c6-6cbec1d3eea6",
      "name": "Step 7: Catch & Fallback Review",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -912,
        16
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE candidates SET status = '{{ $json.new_status }}', ai_evaluation = '{{$json.ai_evaluation.replace(/'/g, \"''\") }}' WHERE id = {{ $json.candidate_id }};",
        "options": {}
      },
