        1960,
        300
      ],
      "credentials": {
        "mySql": {
          "id": "HB0gY7Viximx0kLY",
          "name": "MySQL account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO workflow_logs (workflow_name, execution_status, payload)\nVALUES (\n  'Workflow 1 - Job Posting Agent',\n  'SUCCESS',\n  {{ JSON.stringify(JSON.stringify({ position: $('Step 7: Format Job Record').item.json.position, department: $('Step 7: Format Job Record').item.json.department, status: 'PUBLISHED' })) }}\n);",
        "options": {}
      },
      "id": "w1-step-10-insert-log",
