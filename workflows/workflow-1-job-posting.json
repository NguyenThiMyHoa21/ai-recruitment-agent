{
  "name": "Workflow 1 - AI Job Posting Agent Full 12 Steps",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "job-posting",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "w1-step-1-webhook",
      "name": "Step 1: Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ],
      "webhookId": "job-posting"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.position }}",
              "operation": "isNotEmpty"
            }
          ]
        },
        "options": {}
      },
      "id": "w1-step-2-check-payload",
      "name": "Step 2: Check Payload",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COUNT(*) AS existing_count, COALESCE(MAX(id), 0) AS existing_id FROM jobs WHERE position = {{ JSON.stringify($('Step 1: Webhook').item.json.body.position) }};",
        "options": {
          "alwaysOutputData": true
        }
      },
      "id": "w1-step-3-fetch-existing",
      "name": "Step 3: Check Existing Job",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
      "position": [
        640,
        300
      ],
      "credentials": {
        "mySql": {
          "id": "HB0gY7Viximx0kLY",
          "name": "MySQL account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const body = $('Step 1: Webhook').item.json.body || {};\nconst position = (body.position || '').trim();\nconst department = (body.department || '').trim();\nconst location = (body.location || '').trim();\nconst salary = (body.salary || '').trim();\nconst requirements = (body.requirements || '').trim();\n\nconst prompt = `Bạn là Chuyên viên Tuyển dụng AI (HR Recruitment Assistant).\nHãy viết một bản mô tả công việc (JD) chuyên nghiệp, đầy đủ và chuẩn format tuyển dụng cho vị trí sau:\n- Vị trí tuyển dụng: ${position}\n- Phòng ban: ${department}\n- Địa điểm làm việc: ${location}\n- Mức lương: ${salary}\n- Yêu cầu ứng viên: ${requirements}\n\nYêu cầu bản JD gồm 4 phần rõ ràng: 1. Giới thiệu vị trí | 2. Nhiệm vụ chính | 3. Tiêu chuẩn ứng viên | 4. Quyền lợi đãi ngộ. Trình bày trang trọng, thu hút.`;\n\nreturn [{\n  json: {\n    position: position,\n    department: department,\n    location: location,\n    salary: salary,\n    requirements: requirements,\n    ai_prompt: prompt\n  }\n}];"
      },
      "id": "w1-step-4-build-prompt",
      "name": "Step 4: Build AI Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-lite:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key",
              "value": "AQ.Ab8RN6Lw6M9JouQGiXnzmCpEK-Nf4QwHoWHYlCvHTYj5aqmIkg"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": $json.ai_prompt\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "id": "w1-step-5-request-gemini",
      "name": "Step 5: Request Gemini AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1080,
        300
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const base = $('Step 4: Build AI Prompt').item.json;\nlet aiText = '';\n\ntry {\n  if ($json.candidates && $json.candidates[0].content.parts[0].text) {\n    aiText = $json.candidates[0].content.parts[0].text.trim();\n  } else {\n    throw new Error('Fallback needed');\n  }\n} catch (err) {\n  aiText = `BẢN MÔ TẢ CÔNG VIỆC CHUYÊN NGHIỆP\\n\\n1. VỊ TRÍ TUYỂN DỤNG: ${base.position}\\n2. PHÒNG BAN: ${base.department} | ĐỊA ĐIỂM: ${base.location}\\n3. MỨC LƯƠNG: ${base.salary}\\n4. YÊU CẦU: ${base.requirements}\\n5. QUYỀN LỢI: Môi trường làm việc năng động, lộ trình thăng tiến rõ ràng, thưởng hiệu suất cạnh tranh.`;\n}\n\nreturn [{\n  json: {\n    position: base.position,\n    department: base.department,\n    location: base.location,\n    salary: base.salary,\n    requirements: base.requirements,\n    job_description: aiText\n  }\n}];"
      },
      "id": "w1-step-6-fallback-jd",
      "name": "Step 6: Catch & Fallback JD",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "position",
              "value": "={{ $json.position }}",
              "type": "string"
            },
            {
              "name": "department",
              "value": "={{ $json.department }}",
              "type": "string"
            },
            {
              "name": "location",
              "value": "={{ $json.location }}",
              "type": "string"
            },
            {
              "name": "salary",
              "value": "={{ $json.salary }}",
              "type": "string"
            },
            {
              "name": "requirements",
              "value": "={{ $json.requirements }}",
              "type": "string"
            },
            {
              "name": "job_description",
              "value": "={{ $json.job_description }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "w1-step-7-format-record",
      "name": "Step 7: Format Job Record",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1520,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "status",
              "value": "published",
              "type": "string"
            },
            {
              "name": "approved_by",
              "value": "HR Manager (Nguyen Thi My Hoa)",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "w1-step-8-approval",
      "name": "Step 8: Human Approval",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1740,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO jobs (position, department, location, salary, requirements, job_description, status)\nVALUES (\n  {{ JSON.stringify($('Step 7: Format Job Record').item.json.position) }},\n  {{ JSON.stringify($('Step 7: Format Job Record').item.json.department) }},\n  {{ JSON.stringify($('Step 7: Format Job Record').item.json.location) }},\n  {{ JSON.stringify($('Step 7: Format Job Record').item.json.salary) }},\n  {{ JSON.stringify($('Step 7: Format Job Record').item.json.requirements) }},\n  {{ JSON.stringify($('Step 7: Format Job Record').item.json.job_description) }},\n  {{ JSON.stringify($json.status) }}\n);",
        "options": {}
      },
      "id": "w1-step-9-insert-job",
      "name": "Step 9: Insert Job to MySQL",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
