              "type": "string"
            },
            {
              "name": "position",
              "value": "={{ $('Step 7: Format Job Record').item.json.position }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "w1-step-11-dispatch",
      "name": "Step 11: Dispatch Notification",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2400,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\n  success: true,\n  message: \"Tạo và đăng tin tuyển dụng thành công!\",\n  position: $('Step 7: Format Job Record').item.json.position,\n  department: $('Step 7: Format Job Record').item.json.department,\n  status: $('Step 8: Human Approval').item.json.status,\n  approved_by: $('Step 8: Human Approval').item.json.approved_by,\n  job_description: $('Step 7: Format Job Record').item.json.job_description\n} }}",
        "options": {}
      },
      "id": "w1-step-12-respond",
      "name": "Step 12: Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
